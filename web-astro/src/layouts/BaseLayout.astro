---
// 全局外壳：暖色纸面 + 三维档案终端舞台（#stage 承载 Three.js）+ 字体与令牌导入
import '../styles/tokens.css';
import '../styles/misans.css';
import '../styles/mono.css';

interface Props {
  title?: string;
}
const { title = '万维文 · WITWORK' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#e8e5e1" />
    <meta name="description" content="万维文 WitWork — 本地优先的人机实时协作写作系统：汇万千思路，写一纸文章。" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-pagefind-ignore>
    <main id="viewport">
      <div id="stage"></div>
    </main>
    <noscript>
      <p style="padding: 2rem; font-family: system-ui, sans-serif">
        万维文需要 JavaScript 才能运行。
      </p>
    </noscript>
    <slot />
  </body>
</html>
